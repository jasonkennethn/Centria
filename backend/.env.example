# Centria Backend Environment Configuration Template
# Copy to .env for local development or configure in your deployment platform (e.g. Render, Railway, AWS)
# DO NOT commit real secrets to version control.

# Django Core
SECRET_KEY=replace-with-a-secure-random-secret-key-at-least-50-characters
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,centria-enterprise.onrender.com
FRONTEND_URL=https://centria-enterprise.vercel.app
BACKEND_URL=https://centria-enterprise.onrender.com

# Platform Admin Emails (comma-separated list of emails with platform-wide oversight)
PLATFORM_ADMIN_EMAILS=admin@centria.example.com

# Database (Neon PostgreSQL or any standard PostgreSQL instance)
DATABASE_URL=postgresql://user:password@ep-sample-pooler.region.aws.neon.tech/neondb?sslmode=require

# Neon Object Cloud / S3-compatible Media Storage
AWS_ENDPOINT_URL_S3=https://storage.endpoint.example.com
AWS_ACCESS_KEY_ID=your-s3-access-key-id
AWS_SECRET_ACCESS_KEY=your-s3-secret-access-key
AWS_REGION=ap-southeast-1
S3_BUCKET_NAME=centria-media

# Transactional Email (Brevo / Sendinblue)
BREVO_API_KEY=your-brevo-api-key
EMAIL_SENDER_NAME=Centria
EMAIL_SENDER_ADDRESS=no-reply@celarox.com

# Google Gemini AI
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=models/gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001

# Neon Realtime Layer (optional websocket bridge)
NEON_REALTIME_URL=https://your-neon-realtime-endpoint.example.com
NEON_REALTIME_TOKEN=your-neon-realtime-token
