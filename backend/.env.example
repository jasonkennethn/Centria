# Django Core
SECRET_KEY=your-production-secret-key-here
DEBUG=False
ALLOWED_HOSTS=centria-enterprise.onrender.com,localhost,127.0.0.1
FRONTEND_URL=https://centria-enterprise.vercel.app

# Database (Neon PostgreSQL connection pooler URL)
DATABASE_URL=postgresql://username:password@ep-sample-pooler.region.neon.tech/neondb?sslmode=require

# Neon Object Cloud (S3 Storage)
AWS_ENDPOINT_URL_S3=https://your-neon-object-storage-endpoint
AWS_ACCESS_KEY_ID=your-s3-access-key-id
AWS_SECRET_ACCESS_KEY=your-s3-secret-access-key
AWS_REGION=ap-southeast-1

# Brevo Mail Service
BREVO_API_KEY=your-brevo-api-key-here
